# uploads/ — user-uploaded files (e.g. resumes). Never execute scripts here.

<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|shtml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
